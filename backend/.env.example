PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sky_online
DB_USER=postgres
DB_PASSWORD=password
# Railway can provide this instead of the separate DB_* variables above.
DATABASE_URL=
DB_SSL=false
